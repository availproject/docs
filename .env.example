# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# GitHub token for the feedback widget (creates issues on user feedback)
# Requires `repo` scope for private repos, or use a fine-grained PAT with Issues read/write
GITHUB_FEEDBACK_TOKEN=

# Proxies that append to X-Forwarded-For, used by the feedback rate limit
# Leave empty on Vercel (counts as 1). Use 2 behind Cloudflare plus Traefik
TRUSTED_PROXY_HOPS=
